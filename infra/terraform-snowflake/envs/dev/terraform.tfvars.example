# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# Note what is absent: no password, no private key, no token. If you find yourself adding
# one, see HOW-TO-DEPLOY.md § "If you cannot use WIF" first.

organization_name = "MYORG"
account_name      = "MYACCOUNT"

# Which cloud this Snowflake account runs on. Determines how Terraform authenticates.
workload_identity_provider = "AWS"

# Deliberately not ACCOUNTADMIN. See HOW-TO-DEPLOY.md.
terraform_role = "AGENTIC_DEPLOYER"

# Identities on the host cloud permitted to become each service user. References, not
# secrets — nothing here is sensitive and nothing here rotates.
orchestrator_workload_arn = "arn:aws:iam::123456789012:role/agentic-dev-orchestrator"
executor_workload_arn     = "arn:aws:iam::123456789012:role/agentic-dev-executor"

model_name = "claude-sonnet-4-5"

# Human roles permitted to approve. Empty in dev leaves the gate closed: proposals
# accumulate as PENDING and nothing can claim them. Never name a machine role here.
approver_roles = {
  # oncall = "AGENTIC_DEV_APPROVER"
}
