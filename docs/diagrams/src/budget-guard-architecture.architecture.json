  "cards": [
    {
      "dot": "cyan",
      "title": "Why a loop, not a pipeline",
      "items": [
        "Steps: gather, analyze, draft, review, refine",
        "The agent picks its own next step and can loop back",
        "Step count varies, so the bound is on cost rather than count"
      ]
    },
    {
      "dot": "emerald",
      "title": "Before, not after",
      "items": [
        "A step count lets the agent start what it cannot finish",
        "The budget is checked against the next spend, so it never does"
      ]
    },
    {
      "dot": "rose",
      "title": "Degrade, then name the loss",
      "items": [
        "Quick mode finishes the answer instead of aborting it",
        "\"skipped: review\" is a fact about the answer, not the budget"
      ]
    }
