  "cards": [
    {
      "dot": "cyan",
      "title": "Why the plan is a file",
      "items": [
        "A plan you can read is a plan you can correct before it costs a diff",
        "plan.md survives the session; the context window does not"
      ]
    },
    {
      "dot": "emerald",
      "title": "What closes the loop",
      "items": [
        "learnings.md is only useful if recurring entries get promoted into CLAUDE.md",
        "Verification runs inside the loop, not after the PR is open",
        "/handoff writes state to files so a cleared session resumes from the plan, not from memory"
      ]
    }
  ]
