      },
      {
        "id": "hygiene",
        "label": "Context hygiene",
        "focus": [
          "implement",
          "handoff"
        ],
        "note": "When context gets long the state goes to files; the next session re-reads the plan and resumes sharp."
      }
    ]
  },
