    { "id": "verified", "type": "active", "label": "VERIFIED", "sublabel": "verify() passed", "lane": "main", "col": 2, "step": "03", "tag": "check" },
    { "id": "complete", "type": "success", "label": "COMPLETE", "sublabel": "mark_complete()", "lane": "main", "col": 3, "step": "04", "tag": "done" }
