{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Reads run on the spot; writes wait for a human",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "read",
        "label": "The read half",
        "focus": [
          "request",
          "router",
          "readtools",
          "knowledge"
        ],
        "note": "The router holds read tools only. Reads are ungated and run immediately."
      },
      {
        "id": "write",
        "label": "The write half",
        "focus": [
          "router",
          "proposal",
          "human",
          "executor",
          "writetools",
          "state"
        ],
        "note": "A write leaves the agent as a proposal. Only the approval executor can turn an approved proposal into a call."
      },
      {
        "id": "feedback",
        "label": "The feedback edge",
        "focus": [
          "router",
          "executor",
          "trace",
          "evals"
        ],
        "note": "Both halves emit trace events; trace-eval grades the path, not the answer."
      }
    ]
  },
