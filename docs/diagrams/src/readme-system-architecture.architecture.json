  "cards": [
    {
      "dot": "cyan",
      "title": "The identity platform enforces the split",
      "items": [
        "The router's identity can invoke read tools only; the executor's identity can invoke write tools only",
        "Each cloud maps these boxes onto its own primitives"
      ]
    },
    {
      "dot": "emerald",
      "title": "Approval is bound to exact arguments",
      "items": [
        "The proposal fingerprints the call; the claim is single-use and expires",
        "Changing an argument after approval invalidates it"
      ]
    }
