  "cards": [
    {
      "dot": "cyan",
      "title": "Two roles, one account",
      "items": [
        "Both roles are reached by workload identity federation, with no key",
        "Managed-access schemas stop a schema owner granting around the split"
      ]
    },
    {
      "dot": "rose",
      "title": "The boundary",
      "items": [
        "ORCHESTRATOR holds no grant on any write procedure",
        "Procedures run EXECUTE AS OWNER so the caller cannot borrow rights"
      ]
    },
    {
      "dot": "emerald",
      "title": "Claiming an approval",
      "items": [
        "CLAIM_APPROVAL uses SQLROWCOUNT so only one claim can win",
        "A sweeper task recovers claims that were left stale"
      ]
    }
  ]
